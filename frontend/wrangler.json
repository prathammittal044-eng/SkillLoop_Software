{
  "name": "skillloop-software",
  "compatibility_date": "2025-11-01",
  "main": "./worker.js",
  "vars": {
    "API_BASE_URL": "https://zoggy-skillloop-backend.hf.space"
  },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/socket.io/*",
      "/uploads/*"
    ]
  }
}
