# ==============================================================================
# SkillLoop - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Flask Session Security
SECRET_KEY=skillloop-dev-secret-key-change-in-production

# Google Gemini API Key (Enables AI Adaptive Skill Verification Quizzes)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# WebRTC Video Calling - Metered.ca STUN/TURN Service
# Provides NAT and college-firewall traversal for peer-to-peer video mentoring.
# Get free credentials (50 GB bandwidth/month) at: https://www.metered.ca/
METERED_APP_NAME=your_metered_app_name
METERED_API_KEY=your_metered_api_key

# Optional: Cloudflare Calls TURN (Alternative TURN Provider)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
